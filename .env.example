# Copy to .env and fill in. In dev this points at a local Postgres; in
# production use the hosted Supabase connection string. Prisma 7 reads this
# via prisma.config.ts and the pg driver adapter (no separate DIRECT_URL).
DATABASE_URL="postgresql://USER@localhost:5432/pathways?schema=public"

NEXT_PUBLIC_SITE_URL="https://pathwayswithin.me"
